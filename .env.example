# Lexi local development environment
# Copy this file with: cp .env.example .env
# Do not commit .env. Replace every CHANGE_ME value before starting the app.

# Optional for local development. Required in production.
PLAY_SECRET_KEY=CHANGE_ME_LOCAL_PLAY_SECRET
JWT_SECRET=CHANGE_ME_LOCAL_JWT_SECRET_AT_LEAST_32_CHARACTERS
ADMIN_JWT_SECRET=CHANGE_ME_LOCAL_ADMIN_JWT_SECRET_AT_LEAST_32_CHARACTERS

# The development IP filter is disabled, but keeping this value documents the
# format used in production.
ADMIN_ALLOWED_IPS="127.0.0.1,::1"
TRUSTED_PROXY_CIDRS=""

# Reuse one key pair across releases of this local environment.
WEB_PUSH_ENABLED=false
WEB_PUSH_VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
WEB_PUSH_VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
WEB_PUSH_VAPID_SUBJECT=mailto:admin@example.com

# Create the database and user before starting the application.
DB_URL="jdbc:mysql://localhost:3306/lexi_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Tokyo&useUnicode=true&characterEncoding=UTF-8"
DB_USER=lexi_user
DB_PASSWORD=CHANGE_ME_LOCAL_DB_PASSWORD

# Optional JVM tuning for sbt and Play.
JAVA_OPTS="-Xms512m -Xmx1024m -XX:+UseG1GC"
